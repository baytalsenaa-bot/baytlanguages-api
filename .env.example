# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to Git.

# --- Server ---
PORT=3000
NODE_ENV=production
PUBLIC_SITE_URL=https://baytlanguages.com

# --- Database (Hostinger MySQL — from hPanel > Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=u809140399_bayt
DB_PASSWORD=CHANGE_ME
DB_NAME=u809140399_baytlanguages

# --- Security ---
# Random 32+ character string used to sign/verify tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- Anti-spam (choose one, or leave blank while developing) ---
RECAPTCHA_SECRET_KEY=
HCAPTCHA_SECRET_KEY=

# --- File storage ---
# Absolute path OUTSIDE public_html so files are never web-accessible directly.
PRIVATE_FILES_DIR=/home/u809140399/private_files
MAX_UPLOAD_MB=20

# --- Email notifications (optional, e.g. via SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=info@baytlanguages.com
